# Cadastre estes valores na Vercel: Settings > Environment Variables.
# Sem valor, a ferramenta correspondente simplesmente nao carrega.

# Google Analytics 4 (comeca com G-)
NEXT_PUBLIC_GA_ID=
# Google Ads (comeca com AW-)
NEXT_PUBLIC_ADS_ID=
# Conversao "Clique no WhatsApp" do Google Ads (formato AW-XXXXXXXXX/rotulo)
NEXT_PUBLIC_ADS_CONVERSAO=
# Pixel da Meta (so numeros)
NEXT_PUBLIC_META_PIXEL_ID=
# Coloque 1 no dia do lancamento para liberar o Google
SITE_LIBERADO=
